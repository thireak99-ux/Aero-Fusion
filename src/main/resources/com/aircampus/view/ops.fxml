<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aircampus.ui.OpsController" styleClass="app-root">
    <left><VBox prefWidth="206" minWidth="206" spacing="12" styleClass="sidebar">
      <Label text="AF" styleClass="brand-icon"/><Label text="AeroFusion" styleClass="brand"/>
      <Label text="AIRPORT MANAGEMENT" styleClass="sidebar-kicker"/><Separator/>
      <Label fx:id="userLabel" wrapText="true" styleClass="sidebar-user"/>
      <Button text="Refresh workspace" onAction="#onRefresh" styleClass="nav-button"/>
      <Button text="Flight board" onAction="#onBoard" styleClass="nav-button"/>
      <Button text="Flight tracking" onAction="#onMap" styleClass="nav-button"/>
      <Button text="Notifications" onAction="#onNotifications" styleClass="nav-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="CLASSROOM DEMO" styleClass="sidebar-kicker"/>
      <Label text="Open another login to demonstrate roles together." wrapText="true" styleClass="sidebar-note"/>
      <Button text="Open another login" onAction="#onOtherLogin" styleClass="nav-button"/>
      <Button text="Sign out" onAction="#onLogout" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="14" styleClass="workspace">
      <Label text="Airline operations" styleClass="page-title"/>
      <Label text="Plan schedules, assign resources, and manage flight readiness." styleClass="muted" wrapText="true"/><Label fx:id="summaryLabel" styleClass="summary"/>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"><Tab text="Flight schedules"><VBox spacing="12" styleClass="tab-content"><CheckBox fx:id="historyCheck" text="Include past flights" onAction="#onRefresh"/><TableView fx:id="flightsTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Create flight" onAction="#onCreate" styleClass="primary-button"/><Button text="Edit schedule" onAction="#onEdit" styleClass="button"/><Button text="Assign gate" onAction="#onGate" styleClass="button"/><Button text="Crew assignments" onAction="#onCrew" styleClass="button"/><Button text="Update / cancel status" onAction="#onStatus" styleClass="button"/><Button text="Pre-flight sign-off" onAction="#onPreflight" styleClass="button"/><Button text="Weight check" onAction="#onWeight" styleClass="button"/><Button text="Manifest / requests" onAction="#onManifest" styleClass="button"/><Button text="Report incident" onAction="#onIncident" styleClass="button"/></FlowPane></VBox></Tab></TabPane>
      <Label fx:id="statusLabel" text="Ready. Select a record, then choose an action." wrapText="true" styleClass="status-bar"/>
    </VBox></center>
    </BorderPane>
