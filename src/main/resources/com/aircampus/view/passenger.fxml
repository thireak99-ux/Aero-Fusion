<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aircampus.ui.PassengerController" styleClass="app-root">
    <left><VBox prefWidth="206" minWidth="206" spacing="12" styleClass="sidebar">
      <Label text="AF" styleClass="brand-icon"/><Label text="AeroFusion" styleClass="brand"/>
      <Label text="AIRPORT MANAGEMENT" styleClass="sidebar-kicker"/><Separator/>
      <Label fx:id="userLabel" wrapText="true" styleClass="sidebar-user"/>
      <Button text="Refresh workspace" onAction="#onRefresh" styleClass="nav-button"/>
      <Button text="Flight board" onAction="#onBoard" styleClass="nav-button"/>
      <Button text="Flight tracking" onAction="#onMap" styleClass="nav-button"/>
      <Button text="Notifications" onAction="#onNotifications" styleClass="nav-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="CLASSROOM DEMO" styleClass="sidebar-kicker"/>
      <Label text="Open another login to demonstrate roles together." wrapText="true" styleClass="sidebar-note"/>
      <Button text="Open another login" onAction="#onOtherLogin" styleClass="nav-button"/>
      <Button text="Sign out" onAction="#onLogout" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="14" styleClass="workspace">
      <Label text="Your journey, all in one place" styleClass="page-title"/>
      <Label text="Search a flight, choose your seat, and manage every step before departure." styleClass="muted" wrapText="true"/><Label fx:id="summaryLabel" styleClass="summary"/>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"><Tab text="Find flights"><VBox spacing="12" styleClass="tab-content"><FlowPane hgap="8" vgap="8"><ComboBox fx:id="originBox" prefWidth="200" promptText="Choose..."/><ComboBox fx:id="destinationBox" prefWidth="200" promptText="Choose..."/><DatePicker fx:id="datePicker" prefWidth="150"/><Button text="Search" onAction="#onSearch" styleClass="primary-button"/><Button text="Show all flights" onAction="#onAllFlights" styleClass="button"/></FlowPane><TableView fx:id="flightsTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Flight details / seat map" onAction="#onDetails" styleClass="button"/><Button text="Book selected flight" onAction="#onBook" styleClass="primary-button"/></FlowPane></VBox></Tab><Tab text="My bookings"><VBox spacing="12" styleClass="tab-content"><Label text="Select a booking below. Changes and notifications are saved automatically." styleClass="muted" wrapText="true"/><TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Web check-in" onAction="#onCheckIn" styleClass="primary-button"/><Button text="Boarding pass" onAction="#onPass" styleClass="button"/><Button text="Add baggage" onAction="#onBaggage" styleClass="button"/><Button text="Special requests" onAction="#onRequests" styleClass="button"/><Button text="Track my flight" onAction="#onTrackBooking" styleClass="button"/><Button text="Reschedule" onAction="#onReschedule" styleClass="button"/><Button text="Cancel booking" onAction="#onCancel" styleClass="button"/><Button text="Report lost bag" onAction="#onLostBag" styleClass="button"/></FlowPane></VBox></Tab><Tab text="Baggage claims"><VBox spacing="12" styleClass="tab-content"><Label text="Report a lost bag from My bookings. The airport manager updates its status here." styleClass="muted" wrapText="true"/><TableView fx:id="claimsTable" VBox.vgrow="ALWAYS" minHeight="160"/></VBox></Tab></TabPane>
      <Label fx:id="statusLabel" text="Ready. Select a record, then choose an action." wrapText="true" styleClass="status-bar"/>
    </VBox></center>
    </BorderPane>
