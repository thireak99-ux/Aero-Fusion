<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aircampus.ui.ManagerController" styleClass="app-root">
    <left><VBox prefWidth="206" minWidth="206" spacing="12" styleClass="sidebar">
      <Label text="AF" styleClass="brand-icon"/><Label text="AeroFusion" styleClass="brand"/>
      <Label text="AIRPORT MANAGEMENT" styleClass="sidebar-kicker"/><Separator/>
      <Label fx:id="userLabel" wrapText="true" styleClass="sidebar-user"/>
      <Button text="Refresh workspace" onAction="#onRefresh" styleClass="nav-button"/>
      <Button text="Flight board" onAction="#onBoard" styleClass="nav-button"/>
      <Button text="Flight tracking" onAction="#onMap" styleClass="nav-button"/>
      <Button text="Notifications" onAction="#onNotifications" styleClass="nav-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="CLASSROOM DEMO" styleClass="sidebar-kicker"/>
      <Label text="Open another login to demonstrate roles together." wrapText="true" styleClass="sidebar-note"/>
      <Button text="Open another login" onAction="#onOtherLogin" styleClass="nav-button"/>
      <Button text="Sign out" onAction="#onLogout" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="14" styleClass="workspace">
      <Label text="Airport overview" styleClass="page-title"/>
      <Label text="Review daily operations, incidents, baggage claims, and the audit trail." styleClass="muted" wrapText="true"/><Label fx:id="summaryLabel" styleClass="summary"/>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"><Tab text="Daily report"><VBox spacing="12" styleClass="tab-content"><FlowPane hgap="8" vgap="8"><ComboBox fx:id="weatherBox" prefWidth="200" promptText="Choose..."/><Button text="Apply mock weather" onAction="#onWeather" styleClass="button"/><Button text="Demo &amp; time controls" onAction="#onDemoControls" styleClass="primary-button"/><Button text="Staff directory" onAction="#onStaff" styleClass="button"/><Button text="Export report" onAction="#onExport" styleClass="primary-button"/></FlowPane><TextArea fx:id="reportArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/></VBox></Tab><Tab text="Incidents"><VBox spacing="12" styleClass="tab-content"><TableView fx:id="incidentsTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Resolve incident" onAction="#onResolve" styleClass="primary-button"/><Button text="Manage watchlist" onAction="#onWatchlist" styleClass="button"/><Button text="Report incident" onAction="#onIncident" styleClass="button"/></FlowPane></VBox></Tab><Tab text="Baggage claims"><VBox spacing="12" styleClass="tab-content"><TableView fx:id="claimsTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Update claim status" onAction="#onClaim" styleClass="primary-button"/></FlowPane></VBox></Tab><Tab text="Audit history"><VBox spacing="12" styleClass="tab-content"><TableView fx:id="auditTable" VBox.vgrow="ALWAYS" minHeight="160"/></VBox></Tab></TabPane>
      <Label fx:id="statusLabel" text="Ready. Select a record, then choose an action." wrapText="true" styleClass="status-bar"/>
    </VBox></center>
    </BorderPane>
