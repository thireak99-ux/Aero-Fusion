<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aircampus.ui.CheckinController" styleClass="app-root">
    <left><VBox prefWidth="206" minWidth="206" spacing="12" styleClass="sidebar">
      <Label text="AF" styleClass="brand-icon"/><Label text="AeroFusion" styleClass="brand"/>
      <Label text="AIRPORT MANAGEMENT" styleClass="sidebar-kicker"/><Separator/>
      <Label fx:id="userLabel" wrapText="true" styleClass="sidebar-user"/>
      <Button text="Refresh workspace" onAction="#onRefresh" styleClass="nav-button"/>
      <Button text="Flight board" onAction="#onBoard" styleClass="nav-button"/>
      <Button text="Flight tracking" onAction="#onMap" styleClass="nav-button"/>
      <Button text="Notifications" onAction="#onNotifications" styleClass="nav-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="CLASSROOM DEMO" styleClass="sidebar-kicker"/>
      <Label text="Open another login to demonstrate roles together." wrapText="true" styleClass="sidebar-note"/>
      <Button text="Open another login" onAction="#onOtherLogin" styleClass="nav-button"/>
      <Button text="Sign out" onAction="#onLogout" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="14" styleClass="workspace">
      <Label text="Counter operations" styleClass="page-title"/>
      <Label text="Verify identity, manage seats and baggage, and check passengers in." styleClass="muted" wrapText="true"/><Label fx:id="summaryLabel" styleClass="summary"/>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"><Tab text="Counter and manifest"><VBox spacing="12" styleClass="tab-content"><FlowPane hgap="8" vgap="8"><ComboBox fx:id="counterBox" prefWidth="100" promptText="Choose..."/><ComboBox fx:id="flightBox" prefWidth="400" promptText="Choose..."/><Button text="Open counter" onAction="#onOpen" styleClass="primary-button"/><Button text="Close counter" onAction="#onClose" styleClass="button"/></FlowPane><Label fx:id="counterLabel" styleClass="summary"/><FlowPane hgap="8" vgap="8"><TextField fx:id="lookupField" promptText="Booking reference or passport" prefWidth="260"/><Button text="Find passenger" onAction="#onSearch" styleClass="button"/><Button text="Full manifest" onAction="#onManifest" styleClass="button"/></FlowPane><TableView fx:id="manifestTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Verify photo ID" onAction="#onVerify" styleClass="button"/><Button text="Process check-in / tags" onAction="#onProcess" styleClass="primary-button"/><Button text="Special assistance" onAction="#onRequests" styleClass="button"/><Button text="Boarding pass" onAction="#onPass" styleClass="button"/></FlowPane></VBox></Tab></TabPane>
      <Label fx:id="statusLabel" text="Ready. Select a record, then choose an action." wrapText="true" styleClass="status-bar"/>
    </VBox></center>
    </BorderPane>
