<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aircampus.ui.AtcController" styleClass="app-root">
    <left><VBox prefWidth="206" minWidth="206" spacing="12" styleClass="sidebar">
      <Label text="AF" styleClass="brand-icon"/><Label text="AeroFusion" styleClass="brand"/>
      <Label text="AIRPORT MANAGEMENT" styleClass="sidebar-kicker"/><Separator/>
      <Label fx:id="userLabel" wrapText="true" styleClass="sidebar-user"/>
      <Button text="Refresh workspace" onAction="#onRefresh" styleClass="nav-button"/>
      <Button text="Flight board" onAction="#onBoard" styleClass="nav-button"/>
      <Button text="Flight tracking" onAction="#onMap" styleClass="nav-button"/>
      <Button text="Notifications" onAction="#onNotifications" styleClass="nav-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="CLASSROOM DEMO" styleClass="sidebar-kicker"/>
      <Label text="Open another login to demonstrate roles together." wrapText="true" styleClass="sidebar-note"/>
      <Button text="Open another login" onAction="#onOtherLogin" styleClass="nav-button"/>
      <Button text="Sign out" onAction="#onLogout" styleClass="nav-button"/>
    </VBox></left>
    <center><VBox spacing="14" styleClass="workspace">
      <Label text="Tower control" styleClass="page-title"/>
      <Label text="Sequence aircraft, reserve the runway, and issue validated clearances." styleClass="muted" wrapText="true"/><Label fx:id="summaryLabel" styleClass="summary"/>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"><Tab text="Traffic queue"><VBox spacing="12" styleClass="tab-content"><FlowPane hgap="8" vgap="8"><ComboBox fx:id="flightBox" prefWidth="350" promptText="Choose..."/><ComboBox fx:id="operationBox" prefWidth="130" promptText="Choose..."/><Button text="Add to queue" onAction="#onQueue" styleClass="primary-button"/></FlowPane><FlowPane hgap="8" vgap="8"><Label text="Mock weather:" styleClass="muted" wrapText="true"/><ComboBox fx:id="weatherBox" prefWidth="180" promptText="Choose..."/><Button text="Apply weather" onAction="#onWeather" styleClass="button"/></FlowPane><TableView fx:id="queueTable" VBox.vgrow="ALWAYS" minHeight="160"/><FlowPane hgap="8" vgap="8"><Button text="Assign runway slot" onAction="#onAssign" styleClass="button"/><Button text="Grant clearance" onAction="#onGrant" styleClass="primary-button"/><Button text="Hold flight" onAction="#onHold" styleClass="button"/><Button text="Emergency priority" onAction="#onEmergency" styleClass="button"/><Button text="Release slot / queue" onAction="#onRelease" styleClass="button"/><Button text="Report incident" onAction="#onIncident" styleClass="button"/></FlowPane><Label text="RWY 01 / 19 share one physical runway. Emergency priority never overrides runway occupancy or readiness checks." styleClass="muted" wrapText="true"/></VBox></Tab></TabPane>
      <Label fx:id="statusLabel" text="Ready. Select a record, then choose an action." wrapText="true" styleClass="status-bar"/>
    </VBox></center>
    </BorderPane>
